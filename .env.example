# ClearStack Root Environment Variables
# Copy this file to .env and fill in your values

# ===== BACKEND (FastAPI) =====
# Database
DATABASE_URL=postgresql+psycopg://clearstack:clearstack@db:5432/clearstack

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI API (for non-sensitive content generation)
OPENAI_API_KEY=sk-your-api-key-here

# API Configuration
SERVICE_API_KEY=your-test-key-for-ci
RATE_LIMIT_PER_MINUTE=100

# ===== MOBILE (Expo) =====
# Backend API endpoint for mobile app
EXPO_PUBLIC_API_URL=http://localhost:8000

# ===== DEPLOYMENT =====
# When deploying to production, update:
# - DATABASE_URL to production PostgreSQL instance
# - REDIS_URL to production Redis instance
# - OPENAI_API_KEY to your actual OpenAI key
# - EXPO_PUBLIC_API_URL to your deployed backend URL
